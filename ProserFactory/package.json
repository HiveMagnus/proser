{
  "name": "proser-factory",
  "version": "1.2.0",
  "description": "Proser Factory – AI-powered book generation API server",
  "main": "dist/index.js",
  "bin": {
    "proser": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run codec:build && node scripts/build.mjs",
    "test:build": "node --test scripts/build.test.mjs && npm --prefix vendor/deepmerge test",
    "start": "node dist/index.js",
    "cli": "tsx src/cli/index.ts",
    "worker": "node dist/workers/index.js",
    "db:backfill:scene-wc": "tsx scripts/backfill-scene-wordcounts.ts",
    "db:check:scene-wc": "tsx scripts/check-scene-wordcounts.ts",
    "db:migrate:sqlite": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "lint": "npm run documents:writers && npm run codec:typecheck && eslint . --max-warnings 0",
    "test": "jest --runInBand --coverage",
    "test:smoke": "jest --config jest.config.smoke.cjs",
    "test:smoke:deployed": "node scripts/smoke-deployed.mjs",
    "test:cli": "jest --config jest.config.cli.cjs",
    "benchmark:inference": "node scripts/benchmark-inference.mjs",
    "quality:corpus": "tsx scripts/validate-editorial-corpus.ts",
    "quality:deterministic": "jest --runInBand --coverage=false src/__tests__/editorialQualityLab.test.ts src/__tests__/editorialPolicyAndJudging.test.ts",
    "browser-run:evaluate": "node dist/operators/runNovaBrowserEvaluation.js",
    "browser-receipt:export": "node dist/operators/exportNovaBrowserReceipt.js",
    "docs:generate": "tsx scripts/generate-api-reference.ts",
    "docs:check": "tsx scripts/generate-api-reference.ts --check",
    "typecheck": "npm run codec:build && tsc --noEmit",
    "db:generate": "rm -rf node_modules/.prisma/client && prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "documents:backfill": "tsx scripts/backfill-documents.ts",
    "documents:writers": "node --test scripts/check-document-writers.test.mjs && node scripts/check-document-writers.mjs",
    "codec:build": "node scripts/check-word-codec.cjs",
    "codec:test": "npm --prefix vendor/canvas-docx-codec test",
    "codec:typecheck": "node scripts/check-word-codec.cjs"
  },
  "keywords": [
    "proser",
    "api",
    "backend"
  ],
  "author": "",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/HiveMagnus/proser.git",
    "directory": "ProserFactory"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@hivemagnus/canvas-word-codec": "1.1.0",
    "@inquirer/prompts": "^8.7.5",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/instrumentation": "7.10.1",
    "@xmldom/xmldom": "0.9.12",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "bullmq": "^5.81.5",
    "chalk": "^4.1.2",
    "compression": "1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "ky": "^2.2.0",
    "markdown-it": "15.0.3",
    "ora": "^10.0.0",
    "pg": "^8.23.1",
    "pg-copy-streams": "^7.0.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "playwright": "^1.64.1",
    "prisma": "7.10.1",
    "puppeteer": "25.16.0",
    "saxes": "6.0.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.23.15",
    "verror": "^1.10.1",
    "yargs": "^18.2.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/verror": "^1.10.11",
    "@types/yargs": "^17.0.35",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "^3.3.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.1"
    },
    "@hono/node-server": "^2.0.12",
    "brace-expansion": "5.0.12",
    "fast-uri": "4.2.3",
    "find-my-way": "^9.7.0",
    "js-yaml": "4.3.2",
    "valibot": "^1.4.2",
    "@grpc/grpc-js": "1.14.5",
    "qs": "6.17.1",
    "mysql2": "3.23.1",
    "deepmerge-ts": "8.0.0",
    "browserslist": "4.28.7",
    "baseline-browser-mapping": "2.11.0",
    "fast-copy": "4.1.0",
    "proxy-addr": "2.0.8",
    "systeminformation": "5.33.19",
    "minimatch": "11.0.3",
    "glob": "14.0.3",
    "body-parser": "2.4.0",
    "deepmerge": "file:vendor/deepmerge",
    "test-exclude": "8.0.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
