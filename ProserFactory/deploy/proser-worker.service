[Unit]
Description=Proser Factory — BullMQ Worker
After=proser-factory.service docker.service
Wants=proser-factory.service docker.service
Requires=docker.service

[Service]
Type=simple
User=proser-factory
WorkingDirectory=/opt/proser-factory
EnvironmentFile=/opt/proser-factory/.env
Environment=PUBLICATION_FONT_MANIFEST=/opt/proser-factory/publication-fonts/manifest.json
Environment=USE_BULLMQ=true
ExecStart=/opt/proser-runtime/node-v24.22.1/bin/node dist/workers/index.js
Environment=PATH=/opt/proser-runtime/node-v24.22.1/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=proser-worker

[Install]
WantedBy=multi-user.target
