# Proser Factory — Environment Configuration
# Copy to .env and fill in your values. Generate a different random value for each secret.

# ── Database (PostgreSQL) ──────────────────────────────────────
POSTGRES_PASSWORD=
MIGRATION_EVIDENCE_SIGNING_KEY=
DATABASE_URL=
DATABASE_POOL_SIZE=20

# ── Redis ──────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── AI / OpenAI-Compatible Inference ───────────────────────────
# Preferred llama.cpp endpoint on inference-host. Legacy OLLAMA_* and VLLM_* names are
# still accepted by the app for compatibility with older settings screens.
INFERENCE_BACKEND=llamacpp
INFERENCE_HOST=http://127.0.0.1:8000
# Required in production when INFERENCE_HOST is not loopback. Generate at least
# 32 random characters; the same value is installed on inference-host by the deploy script.
INFERENCE_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:8000
OLLAMA_MODEL=qwen3.6-35b
# Legacy compatibility env vars are still accepted:
# VLLM_BASE_URL=http://127.0.0.1:8000
# VLLM_MODEL=qwen3.6-35b

# ── AI Tuning (optional) ──────────────────────────────────────
# AI_TEMP_BEATS=0.9
# AI_TEMP_PROSE=0.6
# AI_TIMEOUT_PROSE_MS=30000
MAX_CONTEXT_TOKENS=150000
RAG_TOKEN_BUDGET=120000
RAG_MAX_CHUNKS=240
FEEDBACK_MAX_CHARS=600000
AI_MAX_CONCURRENT=8
AI_REQUEST_TIMEOUT_MS=300000
AI_IDLE_TIMEOUT_MS=60000
AI_MAX_RESPONSE_BYTES=16777216
AI_MAX_ERROR_BYTES=65536
AI_MAX_SSE_LINE_BYTES=1048576
AI_MAX_SSE_BUFFER_BYTES=2097152
# Content is never logged by default. Diagnostics require both values and the
# expiry must be no more than one hour in the future.
# AI_DIAGNOSTIC_CONTENT_LOGGING=true
# AI_DIAGNOSTIC_CONTENT_LOGGING_UNTIL=

# ── Security ──────────────────────────────────────────────────
# Shared secret for internal administrative API calls (sync-user and model administration)
INTERNAL_API_SECRET=
# Dedicated signing secret shared only with ProserAuthor's Factory proxy.
# Tokens must use iss=proser-author and aud=proser-factory.
FACTORY_AUTH_SECRET=
# Signed tokens must carry exp and expire within this many seconds (default 86400).
# FACTORY_TOKEN_MAX_LIFETIME_SECONDS=86400
# Nova transport principals and the signed mission-grant verifier. Keep the
# registry private (0600); the public key may be distributed read-only.
# PROSER_SERVICE_PRINCIPALS_JSON=[]
# PROSER_NOVA_GRANTS_FILE=/opt/proser-factory/secrets/nova-grants.json
# PROSER_NOVA_GRANT_PUBLIC_KEY_FILE=/opt/proser-factory/config/nova-grant-ed25519.pub.pem
# Owner-only Ed25519 key used only for fenced provider terminal evidence.
# PROSER_SHARED_RESOURCE_SIGNING_KEY_FILE=/opt/proser-factory/secrets/shared-resource-terminal-ed25519.pem
# PROSER_SHARED_RESOURCE_SIGNING_ISSUER=proser
# Trusted Playwright runner identity and source-only receipt exporter. The
# private key must be an absolute owner-only file; never store the PEM here.
# PROSER_BROWSER_RUN_ISSUER=
# PROSER_BROWSER_TARGET_ORIGIN=https://proser.example.com
# PROSER_BROWSER_TARGET_SERVICE_ID=proser-author
# PROSER_BROWSER_RECEIPT_PRIVATE_KEY_FILE=/opt/proser-factory/secrets/nova-browser-runner-ed25519.pem
# PROSER_BROWSER_RECEIPT_OUTPUT_DIR=/opt/proser-factory/state/nova-browser-receipts
# Dedicated signing secret shared only with enrolled Hermes agents.
# Tokens require iss=hermes-agent and aud=proser-factory by default.
HERMES_AGENT_AUTH_SECRET=
# Preferred with more than one agent host: one secret per agent identity, as a
# JSON object. An identity listed here is accepted only under its own secret.
# HERMES_AGENT_CREDENTIALS={"service:hermes-agent:host-a":"<32+ random characters>"}
# HERMES_AGENT_CREDENTIALS_FILE=/etc/proser/hermes-agent-credentials.json
HERMES_AGENT_GITHUB_ID=service:hermes-agent
HERMES_AGENT_ISSUER=hermes-agent
HERMES_AGENT_AUDIENCE=proser-factory
# Required in production. Send it only as x-metrics-token when scraping
# GET /api/metrics; do not reuse an application or signing secret.
METRICS_TOKEN=
# Temporary migration fallback only. Legacy secrets are ignored unless this is true.
# ALLOW_LEGACY_AUTH_SECRETS=true
# Migration only: rebind an existing account to a new identity by username.
# Leave unset in normal operation; names are not authenticated identifiers.
# ALLOW_LEGACY_IDENTITY_RECONCILIATION=true
# NEXTAUTH_SECRET=
# Comma-separated exact URLs allowed for internal arbitrary model probes/settings.
INFERENCE_ADMIN_HOST_ALLOWLIST=http://127.0.0.1:8000

# ── Server ────────────────────────────────────────────────────
PORT=3001
# Keep production for every installation reachable from another process or
# host. Development relaxes CORS and error detail for local work only.
NODE_ENV=production
# Local development only, with NODE_ENV=development: accept unsigned
# x-user-id / x-github-id identity headers. Never enable on a shared host.
# ALLOW_LEGACY_HEADER_AUTH=true
LOG_LEVEL=info
PROSER_LOG_DIR=/tmp/proser

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins (the UI's deployed URL)
CORS_ALLOWLIST=http://localhost:3000

# ── Workers ───────────────────────────────────────────────────
USE_BULLMQ=true
WORKFLOW_LEASE_MS=120000
# Autonomous Editorial Engine ceilings. Requests may only narrow these values.
EDITORIAL_MAX_ACTIVE_PER_USER=2
EDITORIAL_MAX_ACTIVE_GLOBAL=8
EDITORIAL_MAX_PROPOSALS=100
EDITORIAL_MAX_CANDIDATES_PER_PROPOSAL=2
EDITORIAL_MAX_CHANGED_PERCENT_SCENE=18
EDITORIAL_MAX_CHANGED_PERCENT_TOTAL=12
EDITORIAL_MAX_JUDGE_ESCALATIONS=1
EDITORIAL_MAX_INFERENCE_TOKENS=100000
EDITORIAL_MIN_CONFIDENCE=0.78
EDITORIAL_MIN_PREFERENCE_MARGIN=0.15
EDITORIAL_REFERENCE_OVERLAP_THRESHOLD=0.32
EDITORIAL_LIVE_BENCHMARK_TIMEOUT_MS=45000
# Durable generation admission, replay, cancellation, and cleanup.
GENERATION_MAX_ACTIVE_PER_USER=2
GENERATION_MAX_ACTIVE_GLOBAL=12
GENERATION_MAX_CONCURRENT=2
GENERATION_OPERATION_MAX_BYTES=2097152
GENERATION_REPLAY_MAX_BYTES=2097152
GENERATION_REPLAY_LIMIT=500
GENERATION_REPLAY_TTL_MS=900000
# Pending queue age, running-worker lease, and absolute lifetime are independent.
GENERATION_OPERATION_MAX_PENDING_MS=3600000
GENERATION_OPERATION_LEASE_MS=300000
GENERATION_OPERATION_MAX_LIFETIME_MS=21600000
GENERATION_OPERATION_TTL_SECONDS=604800

# ── Inference deployment (optional) ──────────────────────────
# INFERENCE_USER=deploy-inference
# INFERENCE_SSH_KEY=/absolute/path/to/scoped_deploy_key
# Full pinned known_hosts entry for the selected inference host.
# INFERENCE_SSH_HOST_KEY=

# ── Proser/Hermes deployment transport (optional) ───────────
# Key-only SSH with a repository- or operator-managed pinned hosts file.
# PROSER_USER=
# PROSER_SSH_KEY=/absolute/path/to/scoped_deploy_key
# PROSER_SSH_KNOWN_HOSTS=/absolute/path/to/pinned_known_hosts
# PROSER_SUDO_PASSWORD=

# ── Image Generation (optional) ──────────────────────────────
WEBUI_FORGE_URL=http://127.0.0.1:7861
FORGE_MODEL=qwen-image-2.1
FORGE_SAMPLER=Euler
FORGE_SCHEDULER=Simple
FORGE_STEPS=32

# ── RAG / Skills (optional) ──────────────────────────────────
# RAG_ORCHESTRATOR_ENABLED=true
# RAG_MEMORY_ENABLED=true
# MEMORY_EXTRACTION_ASYNC=true
# SKILLS_RUNTIME_ENABLED=true
# SKILLS_MODE=async

# ── Auto-Update Webhook ──────────────────────────────────────
# WEBHOOK_SECRET=
# WEBHOOK_PORT=9000

# Structured authority activation follows the complete reviewed migration gates.
DOCUMENT_AUTHORITY_ENABLED=false
# Installed absolute JSON font manifest with sha256 and retained license paths.
PUBLICATION_FONT_MANIFEST=
