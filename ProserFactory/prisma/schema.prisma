generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model DatabaseCutoverReceipt {
  operationId              String   @id @map("operation_id")
  sourceSha256             String   @unique(map: "_proser_cutover_receipts_source_sha256_key") @map("source_sha256")
  postgresCheckpointSha256 String   @map("postgres_checkpoint_sha256")
  sourceReportHash         String   @map("source_report_hash")
  targetReportHash         String   @map("target_report_hash")
  report                   Json
  evidenceSignature        String   @map("evidence_signature")
  recordedAt               DateTime @default(now()) @map("recorded_at")

  @@map("_proser_cutover_receipts")
}

model BrowserRun {
  id                   String                   @id
  receiptId            String                   @unique @map("receipt_id")
  issuer               String
  audience             String
  requestId            String                   @map("request_id")
  evaluationId         String                   @unique @map("evaluation_id")
  packageId            String                   @map("package_id")
  packageRevision      Int                      @map("package_revision")
  packageDigest        String                   @map("package_digest")
  surface              String
  targetOrigin         String                   @map("target_origin")
  targetServiceId      String                   @map("target_service_id")
  runnerBuildSha256    String                   @map("runner_build_sha256")
  fixtureSha256        String                   @map("fixture_sha256")
  casePlan             Json                     @map("case_plan")
  casePlanSha256       String                   @map("case_plan_sha256")
  startedAt            DateTime                 @map("started_at")
  createdAt            DateTime                 @default(now()) @map("created_at")
  caseResults          BrowserRunCaseResult[]
  terminal             BrowserRunTerminal?
  receipt              BrowserRunReceipt?

  @@index([requestId, evaluationId], map: "idx_browser_runs_request_evaluation")
  @@map("browser_runs")
}

model BrowserRunCaseResult {
  browserRunId   String     @map("browser_run_id")
  caseId         String     @map("case_id")
  status         String
  evidenceSha256 String     @map("evidence_sha256")
  observedAt     DateTime   @map("observed_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  browserRun     BrowserRun @relation(fields: [browserRunId], references: [id], onDelete: Restrict, map: "browser_run_case_results_run_fkey")

  @@id([browserRunId, caseId])
  @@map("browser_run_case_results")
}

model BrowserRunTerminal {
  browserRunId      String     @id @map("browser_run_id")
  observedAt        DateTime   @map("observed_at")
  outcome           String
  cases             Json
  caseCohortSha256  String     @map("case_cohort_sha256")
  resultSha256      String     @map("result_sha256")
  createdAt         DateTime   @default(now()) @map("created_at")
  browserRun        BrowserRun @relation(fields: [browserRunId], references: [id], onDelete: Restrict, map: "browser_run_terminals_run_fkey")

  @@map("browser_run_terminals")
}

model BrowserRunReceipt {
  browserRunId  String     @id @map("browser_run_id")
  receiptId     String     @unique @map("receipt_id")
  keyId         String     @map("key_id")
  signature     String
  canonicalJson String     @map("canonical_json")
  receiptSha256 String     @unique @map("receipt_sha256")
  expiresAt     DateTime   @map("expires_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  browserRun    BrowserRun @relation(fields: [browserRunId], references: [id], onDelete: Restrict, map: "browser_run_receipts_run_fkey")

  @@map("browser_run_receipts")
}

model User {
  id                   Int                           @id @default(autoincrement())
  githubId             String                        @unique @map("github_id")
  username             String
  email                String?
  avatarUrl            String?                       @map("avatar_url")
  createdAt            DateTime?                     @default(now()) @map("created_at")
  updatedAt            DateTime?                     @default(now()) @updatedAt @map("updated_at")
  books                Book[]
  generationHistory    GenerationHistory[]
  images               ImageAsset[]
  proseTraces          ProseTrace[]
  proseActions         ProseAction[]
  workflowRuns         WorkflowRun[]
  workflowCheckpoints  WorkflowCheckpoint[]          @relation("WorkflowCheckpointDecider")
  editorialProfiles    EditorialProfile[]
  editorialPreferences EditorialPreferenceEvidence[]
  evaluationRuns       EvaluationRun[]

  @@map("users")
}

model Book {
  id                Int          @id @default(autoincrement())
  userId            Int          @map("user_id")
  title             String?
  summary           String?
  genre             String?
  targetAudience    String?      @map("target_audience")
  draftStatus       String?      @default("draft") @map("draft_status")
  createdAt         DateTime?    @default(now()) @map("created_at")
  updatedAt         DateTime?    @default(now()) @updatedAt @map("updated_at")
  tagline           String?
  storyOutline      String?      @map("story_outline")
  storyArchetypeKey String?      @map("story_archetype_key")
  selectedImageId   Int          @default(0) @map("selected_image_id")
  deletedAt         DateTime?    @map("deleted_at")
  acts              Act[]
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  codexEntries      CodexEntry[]

  notes                Note[]
  images               ImageAsset[]
  proseTraces          ProseTrace[]
  proseActions         ProseAction[]
  workflowRuns         WorkflowRun[]
  manuscriptRevisions  ManuscriptRevision[]
  qualityReviewRuns    QualityReviewRun[]
  editorialRuns        EditorialRun[]
  editorialProfiles    EditorialProfile[]
  editorialPreferences EditorialPreferenceEvidence[]
  styleFingerprints    StyleFingerprint[]
  evaluationRuns       EvaluationRun[]

  @@index([userId], map: "idx_books_user_id")
  @@map("books")
}

model NovaResourceClaim {
  id         String   @id @default(uuid())
  kind       String
  resourceId String   @map("resource_id")
  requestId  String   @map("request_id")
  caller     String
  grantId    String   @map("grant_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([kind, resourceId], map: "uniq_nova_resource_claim")
  @@index([requestId, caller, kind], map: "idx_nova_resource_request")
  @@map("nova_resource_claims")
}

model SharedResourceFence {
  resourceKey       String   @id @map("resource_key")
  highestGeneration BigInt   @map("highest_generation")
  operationId       String   @map("operation_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([operationId], map: "idx_shared_resource_fence_operation")
  @@map("shared_resource_fences")
}

model SharedResourceOperation {
  operationId         String    @id @map("operation_id")
  leaseId             String    @map("lease_id")
  claimJson           String    @map("claim_json")
  claimSha256         String    @map("claim_sha256")
  requestSha256       String    @map("request_sha256")
  evidenceDomain      String    @map("evidence_domain")
  method              String
  route                String
  bodySha256           String    @map("body_sha256")
  state                String    @default("admitted")
  responseStatus       Int?      @map("response_status")
  responseJson         String?   @map("response_json")
  resultJson           String?   @map("result_json")
  evidenceSha256       String?   @map("evidence_sha256")
  terminalEvidenceJson String?   @map("terminal_evidence_json")
  executionKind       String?    @map("execution_kind")
  executionId         String?    @map("execution_id")
  generationIdempotencyKey String? @map("generation_idempotency_key")
  generationRequestHash String? @map("generation_request_hash")
  createdAt            DateTime  @default(now()) @map("created_at")
  startedAt            DateTime? @map("started_at")
  completedAt          DateTime? @map("completed_at")

  @@index([leaseId], map: "idx_shared_resource_operation_lease")
  @@index([state, createdAt], map: "idx_shared_resource_operation_state")
  @@unique([executionKind, executionId], map: "uniq_shared_resource_execution")
  @@map("shared_resource_operations")
}

model CodexEntry {
  id               Int               @id @default(autoincrement())
  bookId           Int               @map("book_id")
  entryType        String            @map("entry_type")
  entryName        String            @map("entry_name")
  entryDescription String?           @map("entry_description")
  attributes       String?
  createdAt        DateTime?         @default(now()) @map("created_at")
  updatedAt        DateTime?         @default(now()) @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")
  book             Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  sceneUsages      SceneCodexUsage[]

  @@index([bookId, entryType], map: "idx_codex_book_entry_type")
  @@map("codex_entries")
}

model Act {
  id              Int          @id @default(autoincrement())
  bookId          Int          @map("book_id")
  actNumber       Int          @map("act_number")
  title           String?
  summary         String?
  createdAt       DateTime?    @default(now()) @map("created_at")
  updatedAt       DateTime?    @default(now()) @updatedAt @map("updated_at")
  selectedImageId Int          @default(0) @map("selected_image_id")
  deletedAt       DateTime?    @map("deleted_at")
  book            Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapters        Chapter[]
  proseTraces     ProseTrace[]

  @@unique([bookId, actNumber], map: "uniq_act_book_act_number")
  @@index([bookId], map: "idx_acts_book_id")
  @@map("acts")
}

model Chapter {
  id              Int          @id @default(autoincrement())
  actId           Int          @map("act_id")
  chapterNumber   Int          @map("chapter_number")
  title           String?
  summary         String?
  createdAt       DateTime?    @default(now()) @map("created_at")
  updatedAt       DateTime?    @default(now()) @updatedAt @map("updated_at")
  selectedImageId Int          @default(0) @map("selected_image_id")
  deletedAt       DateTime?    @map("deleted_at")
  act             Act          @relation(fields: [actId], references: [id], onDelete: Cascade)
  scenes          Scene[]
  proseTraces     ProseTrace[]

  @@unique([actId, chapterNumber], map: "uniq_chapter_act_chapter_number")
  @@index([actId], map: "idx_chapters_act_id")
  @@map("chapters")
}

model Scene {
  id              Int               @id @default(autoincrement())
  chapterId       Int               @map("chapter_id")
  sceneNumber     Int               @map("scene_number")
  outline         String?
  beatsMeta       Json?             @map("beats_meta")
  summary         String?
  prose           String?
  wordCount       Int?              @default(0) @map("word_count")
  createdAt       DateTime?         @default(now()) @map("created_at")
  updatedAt       DateTime?         @default(now()) @updatedAt @map("updated_at")
  selectedImageId Int               @default(0) @map("selected_image_id")
  deletedAt       DateTime?         @map("deleted_at")
  chapter         Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  codexUsages     SceneCodexUsage[]
  proseTraces     ProseTrace[]
  proseActions    ProseAction[]

  @@unique([chapterId, sceneNumber], map: "uniq_scene_chapter_scene_number")
  @@index([chapterId], map: "idx_scenes_chapter_id")
  @@map("scenes")
}

model SceneCodexUsage {
  id        Int       @id @default(autoincrement())
  sceneId   Int       @map("scene_id")
  codexId   Int       @map("codex_id")
  usedAt    DateTime? @default(now()) @map("used_at")
  rationale String?
  deletedAt DateTime? @map("deleted_at")

  scene Scene      @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  codex CodexEntry @relation(fields: [codexId], references: [id], onDelete: Cascade)

  @@unique([sceneId, codexId], map: "uniq_scu_scene_codex")
  @@index([sceneId], map: "idx_scu_scene")
  @@index([codexId], map: "idx_scu_codex")
  @@map("scene_codex_usage")
}

model GenerationHistory {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  entityType       String    @map("entity_type")
  entityId         Int?      @map("entity_id")
  prompt           String
  generatedContent String    @map("generated_content")
  modelUsed        String?   @map("model_used")
  createdAt        DateTime? @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entityType], map: "idx_generation_history_user_entity_type")
  @@map("generation_history")
}

model ProseTrace {
  id                      Int                   @id @default(autoincrement())
  traceId                 String                @unique @map("trace_id")
  userId                  Int                   @map("user_id")
  bookId                  Int                   @map("book_id")
  actId                   Int?                  @map("act_id")
  chapterId               Int?                  @map("chapter_id")
  sceneId                 Int?                  @map("scene_id")
  status                  String                @default("pending")
  judgeStatus             String?               @map("judge_status")
  recipeVersion           String?               @map("recipe_version")
  genreKey                String?               @map("genre_key")
  adapterUsed             String?               @map("adapter_used")
  modelUsed               String?               @map("model_used")
  promptText              String?               @map("prompt_text")
  brief                   String?
  promptContextJson       String?               @map("prompt_context_json")
  validatorResultsJson    String?               @map("validator_results_json")
  judgeSummaryJson        String?               @map("judge_summary_json")
  trainerTrainingRunId    String?               @map("trainer_training_run_id")
  trainerPreferencePairId String?               @map("trainer_preference_pair_id")
  trainerOnlineRunId      String?               @map("trainer_online_run_id")
  errorMessage            String?               @map("error_message")
  createdAt               DateTime?             @default(now()) @map("created_at")
  updatedAt               DateTime?             @default(now()) @updatedAt @map("updated_at")
  user                    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  book                    Book                  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  act                     Act?                  @relation(fields: [actId], references: [id], onDelete: SetNull)
  chapter                 Chapter?              @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  scene                   Scene?                @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  candidates              ProseTraceCandidate[]
  findings                ProseFinding[]
  compareCards            ProseCompareCard[]
  actions                 ProseAction[]

  @@index([userId, createdAt], map: "idx_prose_traces_user_created")
  @@index([bookId, createdAt], map: "idx_prose_traces_book_created")
  @@index([sceneId, createdAt], map: "idx_prose_traces_scene_created")
  @@map("prose_traces")
}

model ProseTraceCandidate {
  id             Int        @id @default(autoincrement())
  proseTraceId   Int        @map("prose_trace_id")
  ordinal        Int
  stage          String
  candidateType  String     @map("candidate_type")
  selectionLabel String?    @map("selection_label")
  accepted       Boolean?
  rejected       Boolean?
  outputText     String     @map("output_text")
  wordCount      Int        @default(0) @map("word_count")
  overallScore   Float?     @map("overall_score")
  tier           String?
  metadataJson   String?    @map("metadata_json")
  createdAt      DateTime?  @default(now()) @map("created_at")
  updatedAt      DateTime?  @default(now()) @updatedAt @map("updated_at")
  proseTrace     ProseTrace @relation(fields: [proseTraceId], references: [id], onDelete: Cascade)

  @@unique([proseTraceId, ordinal], map: "uniq_prose_trace_candidates_trace_ordinal")
  @@index([proseTraceId, stage], map: "idx_prose_trace_candidates_trace_stage")
  @@map("prose_trace_candidates")
}

model ProseFinding {
  id           Int                @id @default(autoincrement())
  proseTraceId Int                @map("prose_trace_id")
  source       String
  findingType  String             @map("finding_type")
  severity     String
  title        String?
  message      String
  excerpt      String?
  suggestion   String?
  rationale    String?
  fromOffset   Int?               @map("from_offset")
  toOffset     Int?               @map("to_offset")
  metadataJson String?            @map("metadata_json")
  dismissedAt  DateTime?          @map("dismissed_at")
  createdAt    DateTime?          @default(now()) @map("created_at")
  updatedAt    DateTime?          @default(now()) @updatedAt @map("updated_at")
  proseTrace   ProseTrace         @relation(fields: [proseTraceId], references: [id], onDelete: Cascade)
  compareCards ProseCompareCard[]
  actions      ProseAction[]

  @@index([proseTraceId, source], map: "idx_prose_findings_trace_source")
  @@map("prose_findings")
}

model ProseCompareCard {
  id                Int           @id @default(autoincrement())
  proseTraceId      Int           @map("prose_trace_id")
  proseFindingId    Int?          @map("prose_finding_id")
  title             String
  message           String
  excerpt           String?
  optionALabel      String        @default("Keep") @map("option_a_label")
  optionAText       String        @map("option_a_text")
  optionBLabel      String        @default("Revise") @map("option_b_label")
  optionBText       String        @map("option_b_text")
  recommendedOption String?       @map("recommended_option")
  rationale         String?
  fromOffset        Int?          @map("from_offset")
  toOffset          Int?          @map("to_offset")
  status            String        @default("open")
  metadataJson      String?       @map("metadata_json")
  createdAt         DateTime?     @default(now()) @map("created_at")
  updatedAt         DateTime?     @default(now()) @updatedAt @map("updated_at")
  proseTrace        ProseTrace    @relation(fields: [proseTraceId], references: [id], onDelete: Cascade)
  proseFinding      ProseFinding? @relation(fields: [proseFindingId], references: [id], onDelete: SetNull)
  actions           ProseAction[]

  @@index([proseTraceId, status], map: "idx_prose_compare_cards_trace_status")
  @@map("prose_compare_cards")
}

model ProseAction {
  id                 Int               @id @default(autoincrement())
  proseTraceId       Int               @map("prose_trace_id")
  userId             Int               @map("user_id")
  bookId             Int               @map("book_id")
  sceneId            Int?              @map("scene_id")
  proseFindingId     Int?              @map("prose_finding_id")
  proseCompareCardId Int?              @map("prose_compare_card_id")
  actionType         String            @map("action_type")
  metadataJson       String?           @map("metadata_json")
  createdAt          DateTime?         @default(now()) @map("created_at")
  proseTrace         ProseTrace        @relation(fields: [proseTraceId], references: [id], onDelete: Cascade)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  book               Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  scene              Scene?            @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  proseFinding       ProseFinding?     @relation(fields: [proseFindingId], references: [id], onDelete: SetNull)
  proseCompareCard   ProseCompareCard? @relation(fields: [proseCompareCardId], references: [id], onDelete: SetNull)

  @@index([proseTraceId, createdAt], map: "idx_prose_actions_trace_created")
  @@index([sceneId, createdAt], map: "idx_prose_actions_scene_created")
  @@map("prose_actions")
}

model Note {
  id        Int       @id @default(autoincrement())
  bookId    Int       @map("book_id")
  title     String
  content   String
  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at")
  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId], map: "idx_notes_book_id")
  @@map("notes")
}

model ImageAsset {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  bookId     Int?      @map("book_id")
  name       String
  url        String
  configJson String?   @map("config_json")
  source     String?
  createdAt  DateTime? @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  book       Book?     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId], map: "idx_images_book_id")
  @@index([userId], map: "idx_images_user_id")
  @@map("images")
}

// Factory runner tables
// State values: queued, running, paused, error, done, stalled

// State values: pending, running, completed, error, cancelled, skipped

model AICache {
  id            Int      @id @default(autoincrement())
  model         String
  recipeVersion String   @map("recipe_version")
  promptHash    String   @map("prompt_hash")
  value         String
  ttlSec        Int      @default(604800) @map("ttl_sec")
  hitCount      Int      @default(0) @map("hit_count")
  createdAt     DateTime @default(now()) @map("created_at")
  lastHitAt     DateTime @map("last_hit_at")

  @@unique([model, recipeVersion, promptHash], map: "uniq_ai_cache_key")
  @@index([createdAt], map: "idx_ai_cache_created")
  @@map("ai_cache")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   Int?     @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId], map: "idx_audit_log_user")
  @@index([entityType, entityId], map: "idx_audit_log_entity")
  @@index([createdAt], map: "idx_audit_log_created")
  @@map("audit_log")
}

model RagChunk {
  id           Int      @id @default(autoincrement())
  bookId       Int      @map("book_id")
  sourceType   String   @map("source_type")
  sourceId     String   @map("source_id")
  chunkText    String   @map("chunk_text")
  embedding    Json?
  embedModel   String?  @map("embed_model")
  embedVersion String?  @map("embed_version")
  tokenCount   Int?     @map("token_count")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([bookId, sourceType], map: "idx_rag_chunks_book_source_type")
  @@index([sourceId], map: "idx_rag_chunks_source_id")
  @@index([bookId], map: "idx_rag_chunks_book_id")
  @@map("rag_chunks")
}

model RagEvalResult {
  id           Int      @id @default(autoincrement())
  bookId       Int      @map("book_id")
  sceneId      Int?     @map("scene_id")
  evalType     String   @map("eval_type")
  metrics      Json
  orchestrator String
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([bookId], map: "idx_rag_eval_book_id")
  @@index([evalType], map: "idx_rag_eval_type")
  @@index([createdAt], map: "idx_rag_eval_created")
  @@map("rag_eval_results")
}

model SceneMemoryEvent {
  id         Int      @id @default(autoincrement())
  bookId     Int      @map("book_id")
  sceneId    Int      @map("scene_id")
  eventType  String   @map("event_type")
  actors     Json
  location   String?
  summary    String
  payload    Json?
  confidence Float    @default(0.8)
  ordering   Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([bookId], map: "idx_memory_events_book_id")
  @@index([sceneId], map: "idx_memory_events_scene_id")
  @@index([bookId, eventType], map: "idx_memory_events_book_type")
  @@map("scene_memory_events")
}

model CharacterState {
  id         Int      @id @default(autoincrement())
  bookId     Int      @map("book_id")
  codexId    Int      @map("codex_id")
  sceneId    Int      @map("scene_id")
  stateKey   String   @map("state_key")
  stateValue String   @map("state_value")
  confidence Float    @default(0.8)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([bookId, codexId, sceneId, stateKey], map: "uniq_char_state")
  @@index([bookId, codexId], map: "idx_char_state_book_codex")
  @@index([sceneId], map: "idx_char_state_scene")
  @@index([bookId, stateKey], map: "idx_char_state_book_key")
  @@map("character_states")
}

model PlotThread {
  id           Int      @id @default(autoincrement())
  bookId       Int      @map("book_id")
  threadKey    String   @map("thread_key")
  question     String?
  authorManaged Boolean @default(false) @map("author_managed")
  version      Int      @default(0)
  archivedAt   DateTime? @map("archived_at")
  status       String   @default("open")
  description  String?
  firstSceneId Int?     @map("first_scene_id")
  lastSceneId  Int?     @map("last_scene_id")
