  scopeId                   Int?                @map("scope_id")
  category                  String
  severity                  String
  confidence                Float
  message                   String
  evidence                  String?
  recommendation            String?
  implemented               Boolean             @default(false)
  implementedAt             DateTime?           @map("implemented_at")
  implementingWorkflowRunId String?             @map("implementing_workflow_run_id")
  implementedRevisionId     String?             @map("implemented_revision_id")
  changedScopes             Json?               @map("changed_scopes")
  diffSummary               String?             @map("diff_summary")
  verificationStatus        String              @default("not_implemented") @map("verification_status")
  verificationEvidence      String?             @map("verification_evidence")
  verifiedAt                DateTime?           @map("verified_at")
  waived                    Boolean             @default(false)
