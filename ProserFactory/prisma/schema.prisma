  payload Json
  payloadHash String @map("payload_hash")
  payloadBytes Int @map("payload_bytes")
  sensitiveText String @map("sensitive_text")
  foldedText String @map("folded_text")
  sensitiveGrams String[] @map("sensitive_grams")
  foldedGrams String[] @map("folded_grams")
  sensitiveOverflow Boolean @map("sensitive_overflow")
  foldedOverflow Boolean @map("folded_overflow")
