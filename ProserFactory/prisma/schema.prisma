  implementedRevision       ManuscriptRevision? @relation("FindingImplementedRevision", fields: [implementedRevisionId], references: [id], onDelete: SetNull)

  @@unique([reviewRunId, fingerprint], map: "uniq_quality_finding_review_fingerprint")
  @@index([reviewRunId, implemented, verificationStatus], map: "idx_quality_finding_state")
  @@map("quality_findings_v1")
}

model EditorialRun {
