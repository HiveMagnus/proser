// Clean-slate multi-workflow book production platform.
model WorkflowRun {
  id                     String                  @id
  workflowType           String                  @map("workflow_type")
  parentRunId            String?                 @map("parent_run_id")
  bookId                 Int                     @map("book_id")
  userId                 Int                     @map("user_id")
  sourceRevisionId       String?                 @map("source_revision_id")
  resultRevisionId       String?                 @map("result_revision_id")
  status                 String                  @default("queued")
  statusVersion          Int                     @default(0) @map("status_version")
  phase                  String                  @default("queued")
  settings               Json
  configHash             String                  @default("") @map("config_hash")
  idempotencyKey         String                  @map("idempotency_key")
  leaseOwner             String?                 @map("lease_owner")
  leaseExpiresAt         DateTime?               @map("lease_expires_at")
  executionParentRunId   String?                 @map("execution_parent_run_id")
  recoveryLeaseOwner     String?                 @map("recovery_lease_owner")
  recoveryLeaseExpiresAt DateTime?               @map("recovery_lease_expires_at")
  progress               Json?
  modelPolicy            Json?                   @map("model_policy")
  attemptCount           Int                     @default(0) @map("attempt_count")
  deliveryAttemptCount   Int                     @default(0) @map("delivery_attempt_count")
  recoveryCount          Int                     @default(0) @map("recovery_count")
  maxAttempts            Int                     @default(3) @map("max_attempts")
  cancelRequested        Boolean                 @default(false) @map("cancel_requested")
  failureReason          String?                 @map("failure_reason")
  failureClass           String?                 @map("failure_class")
  lastHeartbeatAt        DateTime?               @map("last_heartbeat_at")
  startedAt              DateTime?               @map("started_at")
  finishedAt             DateTime?               @map("finished_at")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @default(now()) @updatedAt @map("updated_at")
  parent                 WorkflowRun?            @relation("WorkflowChildren", fields: [parentRunId], references: [id], onDelete: Cascade)
  children               WorkflowRun[]           @relation("WorkflowChildren")
  book                   Book                    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceRevision         ManuscriptRevision?     @relation("WorkflowSourceRevision", fields: [sourceRevisionId], references: [id], onDelete: SetNull)
  resultRevision         ManuscriptRevision?     @relation("WorkflowResultRevision", fields: [resultRevisionId], references: [id], onDelete: SetNull)
  producedRevisions      ManuscriptRevision[]    @relation("RevisionWorkflow")
  tasks                  WorkflowTask[]
  artifacts              WorkflowArtifact[]
  checkpoints            WorkflowCheckpoint[]
  events                 WorkflowEvent[]
  reviewRun              QualityReviewRun?
  implementedFindings    QualityFinding[]        @relation("FindingImplementationRun")
  publicationPackages    PublicationPackage[]
  narrativeLedgers       NarrativeLedger[]
  enqueueOutbox          WorkflowEnqueueOutbox[]
  editorialRun           EditorialRun?
  campaignPlans          RevisionCampaignPlan[]

  @@unique([userId, idempotencyKey], map: "uniq_workflow_idempotency")
  @@index([bookId, createdAt], map: "idx_workflow_book_created")
  @@index([userId, status], map: "idx_workflow_user_status")
  @@index([parentRunId], map: "idx_workflow_parent")
  @@index([userId, workflowType, configHash, status], map: "idx_workflow_dedupe")
  @@index([status, leaseExpiresAt], map: "idx_workflow_lease")
  @@index([parentRunId, status], map: "idx_workflow_parent_status")
  @@map("workflow_runs")
}

model WorkflowTask {
  id               String             @id
  runId            String             @map("run_id")
  taskKey          String             @map("task_key")
  taskType         String             @map("task_type")
  phase            String
  scopeType        String             @map("scope_type")
  scopeId          String?            @map("scope_id")
  ordinal          Int
  dependencies     Json
  status           String             @default("pending")
  attemptCount     Int                @default(0) @map("attempt_count")
