  task             WorkflowTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([runId, artifactType], map: "idx_workflow_artifact_type")
  @@map("workflow_artifacts")
}

model WorkflowCheckpoint {
