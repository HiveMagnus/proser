  modelUsed        String?            @map("model_used")
  inputRevisionId  String?            @map("input_revision_id")
  outputRevisionId String?            @map("output_revision_id")
  validationResult Json?              @map("validation_result")
  errorCode        String?            @map("error_code")
  errorMessage     String?            @map("error_message")
  leaseOwner       String?            @map("lease_owner")
  startedAt        DateTime?          @map("started_at")
  finishedAt       DateTime?          @map("finished_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at")
  run              WorkflowRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  artifacts        WorkflowArtifact[]

  @@unique([runId, taskKey], map: "uniq_workflow_task_key")
  @@index([runId, status, ordinal], map: "idx_workflow_task_status")
  @@index([inputRevisionId], map: "idx_workflow_task_input_revision")
  @@index([outputRevisionId], map: "idx_workflow_task_output_revision")
  @@map("workflow_tasks")
}

model WorkflowArtifact {
