# =============================================================================
# Proser V2 — Environment Configuration
# Copy to .env and adjust values for your setup
# =============================================================================

# ─── ProserFactory backend ───────────────────────────────────────────────────
# Same-host deployment: Factory currently serves HTTP on loopback.
# Use an authenticated TLS endpoint when Factory runs on another host.
FACTORY_URL=http://127.0.0.1:3001

# ─── Web UI ──────────────────────────────────────────────────────────────────
# PORT=3000

# ─── Auth (required for production) ──────────────────────────────────────────
# Generate secret: openssl rand -base64 32
# NEXTAUTH_SECRET=
# FACTORY_AUTH_SECRET=
# FACTORY_AUTH_ISSUER=proser-author
# FACTORY_AUTH_AUDIENCE=proser-factory
# NEXTAUTH_URL=http://localhost:3000
# Production: NEXTAUTH_URL=https://proser.example.com
# Production: AUTH_URL=https://proser.example.com
# Marks an Oathweave installation: no local password sign-in is offered.
# Oathweave writers sign in only through OIDC below.
# IAM_CORE_URL=
# Oathweave OpenID Connect sign-in (authorization code + PKCE). See
# docs/OATHWEAVE_OIDC.md in the repository root for the client registration.
# OATHWEAVE_OIDC_ISSUER=https://identity.example.com
# OATHWEAVE_OIDC_CLIENT_ID=hivexui-proser
# OATHWEAVE_OIDC_CLIENT_SECRET=          # confidential clients only
# OATHWEAVE_OIDC_SCOPES=openid profile email
# OATHWEAVE_OIDC_DISCOVERY_URL=          # when discovery is not at <issuer>/.well-known/openid-configuration
# OATHWEAVE_OIDC_AUTHORIZATION_URL=      # explicit endpoints instead of discovery (set all three)
# OATHWEAVE_OIDC_TOKEN_URL=
# OATHWEAVE_OIDC_JWKS_URL=
# OATHWEAVE_OIDC_USERINFO_URL=           # optional
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Required with GitHub sign-in: comma-separated numeric GitHub account IDs.
# GITHUB_ALLOWED_IDS=

# Local/test credentials are disabled unless explicitly enabled.
# LOCAL_AUTH_ENABLED=false
# LOCAL_AUTH_USERNAME=
# LOCAL_AUTH_PASSWORD=
# LOCAL_AUTH_TRUSTED_PROXY_HOPS=0
# LOCAL_AUTH_TRUSTED_PROXY_PEERS=127.0.0.1,::1,10.0.0.0/24

# ─── Purge helpers (optional) ────────────────────────────────────────────────
# PROSER_PURGE_AUTHORING_CONFIRM=delete-test-author-content
# PROSER_PURGE_ALLOW_NONLOCAL=false

# ─── TLS (optional) ─────────────────────────────────────────────────────────
# TLS_ENABLED=false
# TLS_CERT_FILE=
# TLS_KEY_FILE=
# TLS_CA_FILE=
